# Copy to `.env.local` (same folder as `package.json`), then restart `npm run dev`.
#
# Must match `iot-api/.env`:
#   VITE_IOT_API_BASE_URL = http://HOST:PORT  (e.g. http://127.0.0.1:4000)
#   VITE_IOT_API_KEY      = same value as API_KEY

VITE_IOT_API_BASE_URL=http://127.0.0.1:4000
VITE_IOT_API_KEY=my_secret_api_key_123
